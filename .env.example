# Copia este archivo como .env y cambia los valores.
# NUNCA subas el archivo .env a Git.

# RabbitMQ
RABBITMQ_USER=nextalent
RABBITMQ_PASSWORD=cambia-esta-contrasena

# SQL Server (se usa a partir del paso 1.5b)
# Debe tener al menos 8 caracteres y combinar mayusculas, minusculas, numeros y simbolos.
# No uses los caracteres $ " ' \ ni espacios: rompen el healthcheck y la lectura del archivo.
MSSQL_SA_PASSWORD=Cambia-Esta-Contrasena-1

# Backend 2 (Postulaciones y Notificaciones). La contrasena de SQL Server tampoco debe llevar ";".
# JWT: debe ser la misma clave que usa Identidad. Minimo 32 caracteres. Genera una con:
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_ISSUER=NexTalent.Identidad
JWT_AUDIENCE=NexTalent.Api
JWT_KEY=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Clave compartida para que Notificaciones llame a Postulaciones. Minimo 32 caracteres.
INTERNO_API_KEY=cambia-esta-clave-interna-de-al-menos-32-caracteres

# WhatsApp Cloud API (opcional). Sin estos valores el webhook responde 503.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
