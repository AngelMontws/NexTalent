{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identidad-auth": {
        "ClusterId": "identidad",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "identidad-health": {
        "ClusterId": "identidad",
        "Match": { "Path": "/health/identidad" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "vacantes-api": {
        "ClusterId": "vacantes",
        "Match": { "Path": "/api/vacantes/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "vacantes-habilidades": {
        "ClusterId": "vacantes",
        "Match": { "Path": "/api/habilidades/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "vacantes-health": {
        "ClusterId": "vacantes",
        "Match": { "Path": "/health/vacantes" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "postulaciones-api": {
        "ClusterId": "postulaciones",
        "Match": { "Path": "/api/postulaciones/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "postulaciones-estatus": {
        "ClusterId": "postulaciones",
        "Match": { "Path": "/hubs/estatus/{**catch-all}" }
      },
      "postulaciones-health": {
        "ClusterId": "postulaciones",
        "Match": { "Path": "/health/postulaciones" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "notificaciones-whatsapp": {
        "ClusterId": "notificaciones",
        "Match": { "Path": "/whatsapp/{**catch-all}" }
      },
      "notificaciones-health": {
        "ClusterId": "notificaciones",
        "Match": { "Path": "/health/notificaciones" },
        "Transforms": [ { "PathSet": "/health" } ]
      }
    },
    "Clusters": {
      "identidad": {
        "Destinations": { "principal": { "Address": "http://localhost:5001" } }
      },
      "vacantes": {
        "Destinations": { "principal": { "Address": "http://localhost:5002" } }
      },
      "postulaciones": {
        "Destinations": { "principal": { "Address": "http://localhost:5003" } }
      },
      "notificaciones": {
        "Destinations": { "principal": { "Address": "http://localhost:5004" } }
      }
    }
  }
}